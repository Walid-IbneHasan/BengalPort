DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bengal_port?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
API_PORT=4000
API_PUBLIC_URL="http://localhost:4000"
# Set to "true" when the API runs behind a reverse proxy or load balancer.
TRUST_PROXY="false"
GOOGLE_CLIENT_ID=""
PUBLIC_GOOGLE_CLIENT_ID=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Gmail OAuth keys from Google Cloud Console, used instead of SMTP_PASS.
SMTP_OAUTH_CLIENT_ID=""
SMTP_OAUTH_CLIENT_SECRET=""
SMTP_OAUTH_REFRESH_TOKEN=""
EMAIL_FROM="Bengal Port <no-reply@bengalport.com>"
# Team addresses (comma-separated) emailed about each new enquiry and application.
ADMIN_NOTIFY_EMAIL=""
# bKash Tokenized Checkout. Online payment stays off until all four keys are
# set. BKASH_BASE_URL is the sandbox by default; use the live address bKash
# gives you with your live credentials (https://tokenized.pay.bka.sh).
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh"
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
# Local development only: return sign-in codes in the API response when SMTP is
# not configured. Ignored when NODE_ENV=production.
AUTH_DEV_CODES="true"
# Required before seeding a production database (NODE_ENV=production).
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
PUBLIC_API_URL="http://localhost:4000/api"
PUBLIC_WHATSAPP_NUMBER="8801711991035"
FRONTEND_URL="http://localhost:5173"
