generator client {
  provider = "prisma-client-js"
  output = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  USER
  ADMIN
}
enum EnquiryType {
  GENERAL
  BUSINESS
  EDUCATION
  HEALTHCARE
  UMRAH
}
enum ApplicationType {
  BUSINESS
  EDUCATION
  HEALTHCARE
  UMRAH
}
enum RecordStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}
enum OpportunityCategory {
  BUSINESS
  EDUCATION
  HEALTHCARE
  UMRAH
  FACTORY_VISIT
  BUSINESS_TOUR
  SCHOLARSHIP
  EVENT
}
enum PaymentStatus {
  PAID
  PARTIALLY_PAID
  DUE
  PENDING
  FAILED
  REFUNDED
}
enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}
enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}
enum TransactionType {
  INCOME
  EXPENSE
}
enum AuthCodePurpose {
  VERIFY_EMAIL
  LOGIN_2FA
  RESET_PASSWORD
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  phone String?
  passwordHash String?
  googleId String? @unique
  avatarUrl String?
  emailVerifiedAt DateTime?
  twoFactorEnabled Boolean @default(false)
  // Raised when the password changes; sessions issued for an older value stop working.
  tokenVersion Int @default(0)
  lastLoginAt DateTime?
  role Role @default(USER)
  staffNotes StaffNote[]
  reviews Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  enquiries Enquiry[]
  applications Application[]
  payments Payment[]
  authCodes AuthCode[]
}
model AuthCode {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose AuthCodePurpose
  codeHash String
  expiresAt DateTime
  consumedAt DateTime?
  attempts Int @default(0)
  createdAt DateTime @default(now())

  @@index([userId, purpose, createdAt])
}
model Enquiry {
  id String @id @default(cuid())
  type EnquiryType
  name String
  email String?
  phone String
  message String
  details Json?
  status RecordStatus @default(SUBMITTED)
  userId String?
  user User? @relation(fields: [userId], references: [id])
  notes StaffNote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Application {
  id String @id @default(cuid())
  reference String @unique
  type ApplicationType
  status RecordStatus @default(SUBMITTED)
  fullName String
  email String
  phone String
  details Json
  // What the application costs: the division's service fee when submitted,
  // or a quotation set by an administrator. Null until one is known.
  amountDue Decimal? @db.Decimal(12, 2)
  userId String?
  user User? @relation(fields: [userId], references: [id])
  payments Payment[]
  documents ApplicationDocument[]
  notes StaffNote[]
  review Review?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// What staff write to each other about an application or an enquiry. Never
// shown to the customer. The author's name is kept with the note so that it
// still reads properly after their account is removed.
model StaffNote {
  id String @id @default(cuid())
  body String
  applicationId String?
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  enquiryId String?
  enquiry Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  authorId String?
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  createdAt DateTime @default(now())

  @@index([applicationId])
  @@index([enquiryId])
}
// What a customer says about a service they paid for, one per application.
// The website shows it once an administrator has approved it. A review the
// team adds by hand (received outside the website) has no application.
model Review {
  id String @id @default(cuid())
  division ApplicationType
  name String
  detail String?
  rating Int
  body String
  // The picture shown with the review: the member's account photo when they
  // chose to show it, or one the team uploaded.
  photoUrl String?
  status ReviewStatus @default(PENDING)
  applicationId String? @unique
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([division, status])
}
model ApplicationDocument {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name String
  mimeType String
  byteSize Int
  data Bytes
  createdAt DateTime @default(now())

  @@index([applicationId])
}
model Opportunity {
  id String @id @default(cuid())
  slug String @unique
  category OpportunityCategory
  title String
  description String
  country String
  location String
  deadline DateTime?
  image String
  published Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Supplier {
  id String @id @default(cuid())
  name String
  country String
  industry String
  product String
  description String
  image String
  featured Boolean @default(false)
  createdAt DateTime @default(now())
}
model Factory {
  id String @id @default(cuid())
  name String
  country String
  industry String
  product String
  description String
  image String
  featured Boolean @default(false)
  createdAt DateTime @default(now())
}
model Institution {
  id String @id @default(cuid())
  name String
  country String
  description String
  image String
  programs EducationProgram[]
}
model EducationProgram {
  id String @id @default(cuid())
  title String
  level String
  discipline String
  deadline DateTime?
  institutionId String
  institution Institution @relation(fields: [institutionId], references: [id])
}
model Hospital {
  id String @id @default(cuid())
  name String
  country String
  city String
  description String
  image String
  services HealthcareService[]
}
model HealthcareService {
  id String @id @default(cuid())
  title String
  category String
  description String
  hospitalId String?
  hospital Hospital? @relation(fields: [hospitalId], references: [id])
}
model Payment {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id])
  applicationId String?
  application Application? @relation(fields: [applicationId], references: [id])
  service String
  amount Decimal @db.Decimal(12, 2)
  totalDue Decimal @db.Decimal(12, 2)
  method String
  transactionId String @unique
  status PaymentStatus
  provider String @default("mock")
  // Online (bKash) payments: the gateway's identifiers and progress.
  gatewayPaymentId String? @unique
  gatewayTransactionId String?
  gatewayStatus String?
  gatewaySignature String?
  payerAccount String?
  paidAt DateTime?
  createdAt DateTime @default(now())
  receipt Receipt?
  refunds Refund[]
}
// Money returned to a customer for a payment. A bKash payment is refunded
// through bKash, which gives the refund its own number; for any other payment
// staff record how they returned the money. A refund is PENDING while bKash
// has not answered, and FAILED when bKash refused it or never made it.
model Refund {
  id String @id @default(cuid())
  paymentId String
  payment Payment @relation(fields: [paymentId], references: [id])
  amount Decimal @db.Decimal(12, 2)
  reason String
  method String
  status RefundStatus
  gatewayRefundId String? @unique
  recordedBy String
  createdAt DateTime @default(now())

  @@index([paymentId])
}
model Receipt {
  id String @id @default(cuid())
  receiptNumber String @unique
  paymentId String @unique
  payment Payment @relation(fields: [paymentId], references: [id])
  previousDue Decimal @db.Decimal(12, 2)
  remainingDue Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now())
}
model ServiceFee {
  division ApplicationType @id
  label String @default("Service fee")
  amount Decimal @default(0) @db.Decimal(12, 2)
  minimumPayment Decimal @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @default(now()) @updatedAt
}
// bKash allows only two token requests an hour, so the token is kept here and
// reused across restarts.
model GatewayToken {
  provider String @id
  idToken String
  refreshToken String
  expiresAt DateTime
  updatedAt DateTime @default(now()) @updatedAt
}
model FinancialCategory {
  id String @id @default(cuid())
  name String @unique
  type TransactionType
  transactions FinancialTransaction[]
}
model FinancialTransaction {
  id String @id @default(cuid())
  type TransactionType
  date DateTime
  description String
  notes String?
  customer String?
  quantity Decimal? @db.Decimal(10, 2)
  unitPrice Decimal? @db.Decimal(12, 2)
  total Decimal @db.Decimal(12, 2)
  paymentStatus PaymentStatus?
  categoryId String
  category FinancialCategory @relation(fields: [categoryId], references: [id])
  createdAt DateTime @default(now())
}

model PageContent {
  id String @id @default(cuid())
  slug String @unique
  name String
  content Json
  published Boolean @default(true)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id String @id @default(cuid())
  originalName String
  mimeType String @default("image/webp")
  format String @default("webp")
  data Bytes
  width Int
  height Int
  byteSize Int
  orientation String
  purpose String?
  altText String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
